---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageIntro from '../../components/PageIntro.astro';
import { caseStudies, type CaseStudy } from '../../case-studies';
import { offer } from '../../offers';
import { bookingUrl, CTA_LABEL } from '../../config';
import { breadcrumbList } from '../../lib/schema';
import { SITE_URL } from '../../site';
import '../../styles/pages/case-study.css';

export function getStaticPaths() {
  return caseStudies.map(study => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props as { study: CaseStudy };
const pageUrl = `${SITE_URL}/case-studies/${study.slug}/`;
const related = study.related && offer(study.related);
const sections = [
  ['The situation', study.situation],
  ['The expensive problem', study.problem],
  ['What I found', study.found],
  ['The decision', study.decision],
  ['The result', study.result],
] as const;
---
<BaseLayout
  title={`${study.title} | Danny McGiffin`}
  description={study.description}
  image={`/og/case-${study.slug}.png`}
  imageAlt={`${study.title}. A case study by Danny McGiffin, Independent Tech Advisor.`}
  ogType="article"
  structuredData={breadcrumbList([{ name: 'Home', url: `${SITE_URL}/` }, { name: 'Case Studies', url: `${SITE_URL}/case-studies/` }, { name: study.title, url: pageUrl }])}
>
  <SiteHeader bookingPlacement={`case-${study.slug}-navigation`} />
  <main id="main-content">
    <PageIntro eyebrow={`Case study / ${study.context}`} title={`${study.title}.`} deck={study.teaser} />
    <article class="prose service-prose shell case-detail">
      <div class="case-facts" aria-label="Case summary">
        <p><strong>Client</strong><span>{study.context}</span></p>
        <p><strong>My role</strong><span>{study.role}</span></p>
      </div>
      {sections.map(([heading, paragraphs]) => (
        <>
          <h2>{heading}</h2>
          {paragraphs.map(text => <p>{text}</p>)}
        </>
      ))}
      {study.note && <p class="case-note">{study.note}</p>}
      <p class="case-principle">{study.principle}</p>

      <div class="case-next">
        <h2>Facing something similar?</h2>
        <p>We start with a free 30-minute conversation about the business and what’s on the table.</p>
        <p>
          <a href={bookingUrl(`case-${study.slug}`)}>{CTA_LABEL} ↗</a>
          {related ? <a href={related.href}>See the {related.name} ↗</a> : <a href="/case-studies/">More case studies ↗</a>}
        </p>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

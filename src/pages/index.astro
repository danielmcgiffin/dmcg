---
import { Picture } from 'astro:assets';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import OfferSection from '../components/OfferSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { BOOKING_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_DESCRIPTION, HOME_TITLE } from '../site';
import heroImage from '../assets/constraint-hero.png';

const findings = [
	['How it breaks.', 'Fat-finger errors, missed forms, and the "just some quick fixes" you do every time to make it work.'],
	['Where time disappears.', 'Manual steps, duplicate work, waiting, rework, and unnecessary handoffs.'],
	['What it costs.', 'Hours, headcount, delay, errors, and capacity you cannot use somewhere else.'],
	['What should change.', 'Streamline and simplify the process first. Then automate what makes sense.'],
	['What machines can take over.', 'AI, automation, integrations, agents, or deterministic code, whatever solves the problem.']
] as const;
---

<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION} pageType="ProfilePage">
	<SiteHeader />

	<main id="main-content">
		<section class="hero section-dark" aria-labelledby="hero-title">
			<div class="hero-media" aria-hidden="true">
				<Picture
					src={heroImage}
					formats={['avif']}
					fallbackFormat="webp"
					alt=""
					width={heroImage.width}
					height={heroImage.height}
					widths={[768, 1024, 1440, 1920]}
					sizes="100vw"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
					priority
				/>
			</div>
			<div class="media-grain" aria-hidden="true"></div>
			<div class="visual-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

			<div class="hero-copy shell">
				<p class="overline">Operations, AI &amp; automation</p>
				<h1 id="hero-title" class="display display--hero">
					<span class="reveal-clip"><span class="reveal-line">Grow the business.</span></span>
					<span class="reveal-clip"><em class="reveal-line">Not the back office.</em></span>
				</h1>
			</div>

			<div class="hero-bar shell">
				<p>
					<strong>So your existing team can handle more.</strong>
					<span class="hero-note">30 minutes. No pitch deck. Bring me whatever's your current heartburn.</span>
				</p>
				<div class="hero-actions">
					<a class="button button--primary" href={BOOKING_URL}>Show me the work <ArrowUpRight /></a>
				</div>
			</div>
		</section>

		<section class="hero-deck section-dark" aria-label="What more work looks like">
			<div class="shell page-copy">
				<p>
					Every new client, every new contract, creates more work. More onboarding. More reporting. More data
					entry. More approvals. More spreadsheets. More things your experienced people end up tracking,
					managing, checking, and doing by hand.
				</p>
				<p>
					I find the work that is eating your time and margin, redesign it, and automate what should not require a
					person.
				</p>
			</div>
		</section>

		<section class="rule section-light" id="rule" aria-labelledby="rule-title">
			<div class="shell rule-row">
				<div>
					<p class="eyebrow reveal">A simple rule</p>
					<h2 id="rule-title" class="display reveal">Do not hire a person to solve a problem a machine can solve.</h2>
				</div>
				<div class="page-copy reveal">
					<p>Sometimes another hire is exactly the right answer.</p>
					<p>
						But before you add $70,000, $100,000, or $150,000 of annual overhead, it is worth knowing whether the
						work itself needs to exist.
					</p>
					<p>
						Most companies do not have an AI problem. They have expensive people spending expensive hours moving
						information between systems, rebuilding reports, chasing approvals, copying data, checking work, and
						keeping processes alive through sheer institutional knowledge.
					</p>
					<p>
						<strong>What work can we move (or remove) before we add another person?</strong>
					</p>
					<p>That is the question I help answer.</p>
				</div>
			</div>
		</section>

		<section class="find section-dark" id="work" aria-labelledby="find-title">
			<div class="section-grid section-heading">
				<p class="eyebrow reveal">The work</p>
				<div>
					<h2 id="find-title" class="display reveal">The real process is not the one in the SOP.</h2>
					<p class="section-intro reveal">
						I work with your team to see how the work actually happens, not how the SOP says it happens.
					</p>
				</div>
			</div>
			<div class="find-list shell reveal">
				{findings.map(([title, body]) => (
					<div class="find-row">
						<h3>{title}</h3>
						<p>{body}</p>
					</div>
				))}
			</div>
		</section>

		<OfferSection />

		<section class="about section-light" id="why" aria-labelledby="why-title">
			<div class="about-copy reveal">
				<p class="eyebrow">Why me</p>
				<h2 id="why-title" class="display">Operator first.<br />Technologist second.</h2>
				<p>
					I have spent my career inside operations: running teams, fixing broken processes, implementing
					enterprise systems, and dealing with the messy reality between what a system was supposed to do and
					what people actually have to do to make the business run.
				</p>
				<p>
					Now I use AI and automation as operating tools. Because sometimes
					<strong> ten hours of work should become ten minutes of work.</strong>
					{' '}You do not just save ten hours, you remove a constraint on the business.
				</p>
			</div>
		</section>

		<section class="closer section-dark" id="contact" aria-labelledby="closing-title">
			<div class="shell closer-inner reveal">
				<h2 id="closing-title" class="display">
					<a class="closer-ask" href={BOOKING_URL}
						><span>Before you hire another person, show me the work.</span></a>
				</h2>
				<p class="hero-note">No sales presentation required.</p>
			</div>
		</section>
	</main>

	<SiteFooter />

	<script is:inline>
		if(!CSS.supports('animation-timeline:scroll()')){let o=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>o.observe(e))}
	</script>
</BaseLayout>

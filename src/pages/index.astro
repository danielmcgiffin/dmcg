---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvisorSidebar from '../components/AdvisorSidebar.astro';
import AdvisorFooter from '../components/AdvisorFooter.astro';
import { HOME_TITLE, HOME_DESCRIPTION } from '../site';
import { bookingUrl } from '../config';

const triggers = [
  '“We need an ERP.”',
  '“None of our systems talk to each other.”',
  '“We can’t trust our numbers.”',
  '“We’ve already spent too much for this not to work.”',
  '“What could we actually use AI for?”',
  '“The vendor says this is just how the system works.”',
];
const projects = [
  {
    title: 'The ERP we decided not to implement', context: 'PE-backed distributor', anchor: 'erp',
    result: 'Stopped a misfit ERP rollout and designed an alternative estimated at ~$50K.',
    situation: 'The company had purchased an enterprise ERP. During implementation, I found that the software could not represent how the business actually made money.',
    work: 'The five-year license was contracted at $1.25M. Implementation was first estimated at $600K, then at least $1.2M with custom code. That put the projected path at $2.45M or more, with workarounds still required. The CEO stopped the implementation. I designed an alternative around systems the company already had.',
    outcome: 'The CEO stopped the implementation after about $350K had been paid. I designed an alternative using existing systems, with full implementation estimated at roughly $50K—about 2% of the projected $2.45M+ ERP license-and-implementation path.',
  },
  {
    title: 'Redesigning an operating model that made collaboration irrational', context: 'Professional services', anchor: 'collaboration',
    result: 'Won executive approval for a model designed to make cross-practice collaboration worthwhile.',
    situation: 'A professional-services firm wanted its practices to work together in the federal market. Their incentives made that a bad deal.',
    work: 'I redesigned the model so commercial practices owned the client relationship and Federal supplied the contracting, administration, and delivery support.',
    outcome: 'The executive team approved the model and its potential use across related businesses.',
  },
  {
    title: 'Building the company underneath 10× growth', context: 'Professional services', anchor: 'growth',
    result: 'Recognized revenue grew about 10× and the team retained every employee during the period.',
    situation: 'A growing professional-services firm needed management, delivery, hiring, and reporting systems to support a rapidly expanding team.',
    work: 'I built those systems and operating routines, including monthly conversations between the CEO and every employee.',
    outcome: 'Firm-wide recognized revenue grew from about $200K to $2M in roughly a year, while the team retained every employee. I built the management and delivery systems that helped the firm handle that growth.',
  },
  {
    title: 'Making improper payments measurable and controllable', context: 'U.S. Navy', anchor: 'navy',
    result: 'Program reporting showed a roughly $250M decline in estimated improper payments, 2015–2019.',
    situation: 'The Navy needed a reliable way to estimate improper payments before it could credibly reduce them.',
    work: 'Working with finance and payment experts, I helped build statistical models, risk assessments, review methods, controls, training, and leadership reporting.',
    outcome: 'The OSD CFO pointed to the program as a model for other services. Internal program reporting showed a roughly $250M decline in estimated improper payments between 2015 and 2019, with underlying error rates down about 45% in a separate two-year comparison. These were program results, not recovered cash.',
  },
];
import '../styles/pages/index.css';
---
<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION} bodyClass="consulting-home">
  <AdvisorSidebar current="/" />
  <main id="main-content" class="consulting-main">
    <section class="consulting-intro" aria-labelledby="hero-title">
      <div>
        <p class="consulting-label">Independent Tech Advisor</p>
        <h1 id="hero-title">Before you spend a bunch of money on a new system, make sure it's actually what you need.</h1>
        <p class="consulting-deck">I help owners and executives define a tech strategy, audit their existing stack and processes, and design the ideal future to help the business accomplish its goals and avoid expensive mistakes.</p>
        <a class="consulting-button" href={bookingUrl('hero')}>Get a second opinion</a>
      <p class="consulting-first-step">We start with a free 30-minute introduction. We’ll discuss the business and its symptoms, then decide whether it's worthwhile to dig deeper. <a href="/advisory/">See how the review works ↗</a></p>
      </div>
      <img class="consulting-portrait" src="/headshot.jpg" width="400" height="400" alt="Danny McGiffin" fetchpriority="high" />
    </section>

    <section class="consulting-section consulting-about consulting-featured" aria-labelledby="decision-title">
      <p class="consulting-label">Case study</p>
      <h2 id="decision-title">The ERP we decided not to implement</h2>
      <p>A PE-backed distributor had bought an ERP that couldn't actually handle how it saw its business. The implementation estimate rose from ~$500k to at least $1.2M as more and more custom code requirements were surfaced, and when all was said and done, the system would <em>still</em> have required workarounds.</p>
      <p>I recommended the business stop the implementation and seek redress from the vendor. Then I designed an alternative solution around systems already in use for ~5% of the cost that would accomplish their actual goal: better financial reporting.</p>
      <a class="consulting-inline-link" href="/work/erp-second-opinion/">Read the ERP case ↗</a>
    </section>

    <figure class="consulting-testimonial">
      <blockquote><p>“Working with Danny was excellent. He didn't just come in and automate what we had. He studied the problem, stripped away the noise, and eliminated work that shouldn’t have existed in the first place.”</p></blockquote>
      <figcaption><strong>Roger Porres</strong><span>Director of Ancillary Services</span></figcaption>
    </figure>

    <section class="consulting-section" aria-labelledby="triggers-title">
      <h2 class="consulting-label" id="triggers-title">When you hear yourself saying…</h2>
      <div class="consulting-engagements">{triggers.map(trigger => <article><h3>{trigger}</h3></article>)}</div>
      <p class="consulting-note">It’s worth getting an independent view before you go further.</p>
    </section>

    <section class="consulting-section" aria-labelledby="engagement-title">
      <h2 class="consulting-label" id="engagement-title">How we can work together</h2>
      <div class="consulting-engagements">
        <article><h3>Advisory</h3><p>Independent judgment on a consequential decision. Think through what’s happening, test assumptions, compare options, and determine what actually needs to change.</p></article>
        <article><h3>Design</h3><p>Make a concrete plan for responsibilities, decisions, information flow, and systems so the business can work differently.</p></article>
        <article><h3>Build</h3><p>Make the change real where hands-on help is appropriate: systems, integrations, software, automation, implementation oversight, or program & vendor management.</p></article>
      </div>
      <p class="consulting-note">The answer can be new software, integration, better data, clearer ownership, a different process or vendor, or no major purchase at all. <a href="/advisory/">Read about the independent review.</a></p>
    </section>

    <section class="consulting-section" id="work" aria-labelledby="work-title">
      <h2 class="consulting-label" id="work-title">Selected work</h2>
      <div class="consulting-projects">
        {projects.map(project => (
          <div class="consulting-project-card">
            <details>
              <summary><span>{project.title} <strong>{project.context}</strong><small>{project.result}</small></span><span class="project-toggle" aria-hidden="true">+</span></summary>
              <div class="consulting-project-body">
                <p>{project.situation}</p><p>{project.work}</p><p>{project.outcome}</p>
              </div>
            </details>
            <div class="consulting-project-footer">
              <a class="project-link" href={project.anchor === 'erp' ? '/work/erp-second-opinion/' : `/about/#${project.anchor}`}>Read the full account ↗</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="consulting-section consulting-about" aria-labelledby="about-title">
      <h2 class="consulting-label" id="about-title">About me</h2>
      <p>I work on the problems where everyone is seeing a different piece. Finance sees reporting. Operations sees workarounds. IT sees systems. The vendor sees implementation. Leadership sees cost.</p>
      <p>My role is to step far enough back to figure out what root problem the business actually has, before everyone spends more money solving their version of the symptoms.</p>
      <p>My path has taken me from the Army into consulting, operations, enterprise systems, organizational redesign, and strategy. I’m based in Herndon, Virginia, and work directly with owners and executives.</p>
      <a class="consulting-inline-link" href="/about/">More about me and the work ↗</a>
    </section>

    <section class="consulting-close" aria-labelledby="conversation-title">
      <h2 id="conversation-title">About to make an expensive systems decision?</h2>
      <p>You don’t need to have the problem neatly framed. In fact, that’s usually the point.</p>
      <a class="consulting-button" href={bookingUrl('closing')}>Get a second opinion</a>
      <a class="consulting-inline-link" href="/contact/">Or get in touch ↗</a>
    </section>
    <AdvisorFooter />
  </main>
</BaseLayout>

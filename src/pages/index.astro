---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ClosingCta from '../components/ClosingCta.astro';
import OfferSection from '../components/OfferSection.astro';
import ProofSection from '../components/ProofSection.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { BOOKING_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ABOUT_LOCATION, HOME_DESCRIPTION, HOME_TITLE } from '../site';
import heroImage from '../assets/constraint-hero.png';

const description = HOME_DESCRIPTION;
const heroLine = 'I help growing companies redesign expensive manual workflows and build the systems and AI to run them better.';

const services = [
	['AI Opportunity Sprint', 'Find the expensive, time-consuming, manual work and put numbers on it.'],
	['Workflow Design', 'Redesign the process before picking out any tooling for it.'],
	['AI & Automation', 'Build the tools, agents, and integrations to supercharge your operations.'],
	['Implementation', 'Put them into the actual workflow and train the team on their use.'],
	['Measurement', 'Measure time, cost, throughput, and ROI.']
] as const;

const articles = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 2);

const proofEntries = await getCollection('proof');
const proofHeadline = import.meta.env.PROOF_HEADLINE?.trim() ?? '';
const proofEnabled = import.meta.env.SHOW_PROOF === 'true';
const showProof = proofEnabled && proofEntries.length > 0 && proofHeadline.length > 0;

if (!showProof) {
	const missing = [
		...(!proofEnabled ? ['SHOW_PROOF=true'] : []),
		...(proofHeadline.length === 0 ? ['PROOF_HEADLINE'] : []),
		...(proofEntries.length === 0 ? ['at least one verified entry containing metric_line, context, and attribution'] : [])
	];
	console.warn(`[proof] Evidence section not rendered. Missing: ${missing.join('; ')}.`);
}
---

<BaseLayout title={HOME_TITLE} description={description} pageType="ProfilePage">
	<SiteHeader />

	<main id="main-content">
		<section class="hero section-dark" aria-labelledby="hero-title">
			<div class="hero-media" aria-hidden="true">
				<Picture
					src={heroImage}
					formats={['avif']}
					fallbackFormat="webp"
					alt=""
					width={heroImage.width}
					height={heroImage.height}
					widths={[768, 1024, 1440, 1920]}
					sizes="100vw"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
					priority
				/>
			</div>
			<div class="media-grain" aria-hidden="true"></div>
			<div class="visual-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

			<div class="hero-copy shell">
				<p class="overline">Workflow systems & AI</p>
				<h1 id="hero-title" class="display display--hero">
					<span class="reveal-clip"><span class="reveal-line">Your best people</span></span>
					<span class="reveal-clip"><span class="reveal-line">should not be doing</span></span>
					<span class="reveal-clip"><em class="reveal-line">machine work.</em></span>
				</h1>
			</div>

			<div class="hero-bar shell">
				<p>{heroLine}</p>
				<div class="hero-actions">
					<a class="button button--ghost" href="/ai-opportunity-sprint/">AI Opportunity Sprint <ArrowUpRight /></a>
					<a class="button button--primary" href={BOOKING_URL}>Book a call <ArrowUpRight /></a>
				</div>
			</div>
		</section>

		<section class="thesis section-light section-grid" id="thesis" aria-labelledby="thesis-title">
			<p class="eyebrow reveal">Thesis</p>
			<div class="thesis-content">
				<h2 id="thesis-title" class="display reveal">I fix the work<br /><em>around</em> the<br />software <em>first...</em></h2>
				<div class="thesis-notes reveal">
					<p>...by building AI-powered, human-centered operations. <br /><br />You can't put a turbo on a car with a bad transmission, and AI won't fix your company. Not unless you redesign the work first. </p>
					<p>I start with your goals and strategy, and work with you to find out if the workflow as it exists today is how it should exist <em>in an AI future</em>.<br /><br />We'll find opportunities to get your people focused on the things humans do best, like using their judgement and finding creative solutions.<br /><br />And we'll do this by redesigning the workflow to make the most of computers where they can handle the <em>machine work</em>.</p>
				</div>
			</div>
		</section>

		<section class="process section-dark" id="process" aria-labelledby="process-title">
			<div class="section-grid section-heading">
				<p class="eyebrow reveal">Process</p>
				<div>
					<h2 id="process-title" class="display reveal">From expensive work<br />to <em>working systems.</em></h2>
					<p class="section-intro reveal">I take you from strategy to value with clarity and speed. I work with you and your team to examine the workflow, redesign the work, build what it needs to supercharge it, and measure whether it worked.</p>
				</div>
			</div>
			<div class="process-list shell reveal">
				{services.map((service) => (
					<div class="process-row">
						<span class="index"></span>
						<h3>{service[0]}</h3>
						<p>{service[1]}</p>
					</div>
				))}
			</div>
		</section>

		{showProof && <ProofSection entries={proofEntries} headline={proofHeadline} />}
		<OfferSection />


		<section class="about section-dark" id="about" aria-labelledby="about-title">
			<div class="about-copy reveal">
				<p class="eyebrow">About Danny</p>
				<h2 id="about-title" class="display">Operator first.<br /><em>Technologist second.</em></h2>
				<p>I work at the join between operations and software: understanding the business' strategy, deciphering how a business actually runs, redesigning the work around technology, and building practical systems that make the new process stick.</p>
				<p>{ABOUT_LOCATION}</p>
				<ol>
					<li><span>01</span>Workflow and constraint analysis</li>
					<li><span>02</span>Systems and AI implementation</li>
					<li><span>03</span>Plain-language operating design</li>
					<li><span>04</span>Measurable and measured business outcomes</li>
				</ol>
			</div>
		</section>

		<section class="writing section-light section-grid" id="writing" aria-labelledby="writing-title">
			<p class="eyebrow reveal">Writing</p>
			<div class="writing-content">
				<h2 id="writing-title" class="display reveal">Notes on work,<br />systems, and <em>leverage.</em></h2>
				<div class="article-grid reveal">
					{articles.map((article) => (
						<a href={`/writing/${article.id}/`}>
							<h3>{article.data.title}</h3>
							<p>{article.data.description}</p>
							<span>Read note <ArrowUpRight /></span>
						</a>
					))}
				</div>
				<a class="text-link writing-more reveal" href="/writing/">Read More <ArrowUpRight /></a>
			</div>
		</section>

		<ClosingCta image={heroImage} />
	</main>

	<SiteFooter />

	<script is:inline>
		if(!CSS.supports('animation-timeline:scroll()')){let o=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>o.observe(e))}
	</script>
</BaseLayout>

---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ClosingCta from '../components/ClosingCta.astro';
import OfferSection from '../components/OfferSection.astro';
import ProofSection from '../components/ProofSection.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { BOOKING_URL } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/constraint-hero.png';

const description = 'I help growing companies redesign expensive manual workflows and build the systems and AI to run them better.';

const services = [
	['Workflow Review', 'Find the expensive manual work and put numbers on it.'],
	['Workflow Design', 'Redesign the process before automating it.'],
	['AI & Automation', 'Build the tools, agents, and integrations.'],
	['Implementation', 'Put them into the actual workflow.'],
	['Measurement', 'Measure time, cost, throughput, and ROI.']
] as const;

const capabilities = [
	['Workflow intelligence', 'Turn scattered operating knowledge into a system people can navigate and use.'],
	['AI-assisted operations', 'Give repetitive research, drafting, and coordination work to well-governed agents.'],
	['Process integration', 'Connect the tools already in use so information moves without manual re-entry.'],
	['Decision systems', 'Make important operating signals visible early enough for a person to act.']
] as const;

const articles = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 2);

const proofEntries = await getCollection('proof');
const proofHeadline = import.meta.env.PROOF_HEADLINE?.trim() ?? '';
const proofEnabled = import.meta.env.SHOW_PROOF === 'true';
const showProof = proofEnabled && proofEntries.length > 0 && proofHeadline.length > 0;

if (!showProof) {
	const missing = [
		...(!proofEnabled ? ['SHOW_PROOF=true'] : []),
		...(proofHeadline.length === 0 ? ['PROOF_HEADLINE'] : []),
		...(proofEntries.length === 0 ? ['at least one verified entry containing metric_line, context, and attribution'] : [])
	];
	console.warn(`[proof] Evidence section not rendered. Missing: ${missing.join('; ')}.`);
}
---

<BaseLayout title="Danny McGiffin — Workflow Systems & AI" description={description}>
	<SiteHeader />

	<main id="main-content">
		<section class="hero section-dark" aria-labelledby="hero-title">
			<div class="hero-media" aria-hidden="true">
				<Picture
					src={heroImage}
					formats={['avif']}
					fallbackFormat="webp"
					alt=""
					width={heroImage.width}
					height={heroImage.height}
					widths={[768, 1024, 1440, 1920]}
					sizes="100vw"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
					priority
				/>
			</div>
			<div class="media-grain" aria-hidden="true"></div>
			<div class="visual-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

			<div class="hero-copy shell">
				<p class="overline">Workflow systems & AI</p>
				<h1 id="hero-title" class="display display--hero">
					<span class="reveal-clip"><span class="reveal-line">Your people</span></span>
					<span class="reveal-clip"><span class="reveal-line">should not be doing</span></span>
					<span class="reveal-clip"><em class="reveal-line">machine work.</em></span>
				</h1>
			</div>

			<div class="hero-bar shell">
				<p>{description}</p>
				<div class="hero-actions">
					<a class="button button--ghost" href="/workflow-review/">Workflow Review <ArrowUpRight /></a>
					<a class="button button--primary" href={BOOKING_URL}>Book a call <ArrowUpRight /></a>
				</div>
			</div>
		</section>

		<section class="thesis section-light section-grid" id="thesis" aria-labelledby="thesis-title">
			<p class="eyebrow reveal">Thesis/</p>
			<div class="thesis-content">
				<h2 id="thesis-title" class="display reveal">I fix the work<br />around the<br /><em>software.</em></h2>
				<div class="thesis-notes reveal">
					<p>Most companies do not need another AI tool.</p>
					<p>They need to find the work that costs too much, understand why, redesign it, and automate what should never have required a person.</p>
				</div>
			</div>
		</section>

		<section class="process section-dark" id="process" aria-labelledby="process-title">
			<div class="section-grid section-heading">
				<p class="eyebrow reveal">Process/</p>
				<div>
					<h2 id="process-title" class="display reveal">From expensive work<br />to <em>working systems.</em></h2>
					<p class="section-intro reveal">I diagnose the workflow, redesign it, build what it needs, put it into operation, and measure whether it worked.</p>
				</div>
			</div>
			<div class="process-list shell reveal">
				{services.map((service, index) => (
					<div class="process-row">
						<span class="index">{String(index + 1).padStart(2, '0')}//05</span>
						<h3>{service[0]}</h3>
						<p>{service[1]}</p>
					</div>
				))}
			</div>
		</section>

		{showProof && <ProofSection entries={proofEntries} headline={proofHeadline} />}
		<OfferSection />

		<section class="work section-light section-grid" id="work" aria-labelledby="work-title">
			<p class="eyebrow reveal">Selected Work/</p>
			<div class="work-content">
				<div class="work-heading reveal">
					<h2 id="work-title" class="display">Systems built for<br /><em>real work.</em></h2>
					<p>A selection of the operating problems I work on—from fragmented handoffs to decision support and AI-assisted execution.</p>
				</div>
				<div class="capability-grid reveal">
					{capabilities.map((capability, index) => (
						<article>
							<span class="index">{String(index + 1).padStart(2, '0')}</span>
							<h3>{capability[0]}</h3>
							<p>{capability[1]}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="about section-dark" id="about" aria-labelledby="about-title">
			<div class="about-copy reveal">
				<p class="eyebrow">About Danny/</p>
				<h2 id="about-title" class="display">Operator first.<br /><em>Technologist second.</em></h2>
				<p>I work at the seam between operations and software: understanding how a business actually runs, redesigning the work, and building practical systems that make the new process stick.</p>
				<ol>
					<li><span>01</span>Workflow and constraint analysis</li>
					<li><span>02</span>Systems and AI implementation</li>
					<li><span>03</span>Plain-language operating design</li>
					<li><span>04</span>Measured business outcomes</li>
				</ol>
			</div>
		</section>

		<section class="writing section-light section-grid" id="writing" aria-labelledby="writing-title">
			<p class="eyebrow reveal">Writing/</p>
			<div class="writing-content">
				<h2 id="writing-title" class="display reveal">Notes on work,<br />systems, and <em>leverage.</em></h2>
				<div class="article-grid reveal">
					{articles.map((article) => (
						<a href={`/writing/${article.id}/`}>
							<h3>{article.data.title}</h3>
							<p>{article.data.description}</p>
							<span>Read note <ArrowUpRight /></span>
						</a>
					))}
				</div>
			</div>
		</section>

		<ClosingCta image={heroImage} />
	</main>

	<footer class="site-footer section-dark">
		<a class="footer-brand" href="/"><span class="monogram" aria-hidden="true"><span>D</span></span> Danny McGiffin</a>
		<p>Workflow systems and AI for growing companies.</p>
		<div><a href="https://www.linkedin.com/in/danny-mcgiffin/">LinkedIn <ArrowUpRight /></a><span>© 2026</span></div>
	</footer>

	<script is:inline>
		if(!CSS.supports('animation-timeline:scroll()')){let o=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>o.observe(e))}
	</script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvisorSidebar from '../components/AdvisorSidebar.astro';
import AdvisorFooter from '../components/AdvisorFooter.astro';
import Identity from '../lib/sections/home/Identity.astro';
import SelectedWork from '../lib/sections/home/SelectedWork.astro';
import Testimonial from '../lib/sections/home/Testimonial.astro';
import Writing from '../lib/sections/home/Writing.astro';
import NextStep from '../lib/sections/home/NextStep.astro';
import { homeMeta, identity, nextStep, selectedWorkSection, writingSection } from '../lib/content/home';
import { selectedWork } from '../lib/content/work';
import { featuredTestimonial } from '../lib/content/testimonials';
import { latestFieldNotes } from '../lib/content/writing';
import '../styles/pages/index.css';
---
<BaseLayout title={homeMeta.title} description={homeMeta.description} image="/og/home.png" imageAlt={homeMeta.imageAlt} bodyClass="consulting-home">
  <AdvisorSidebar current="/" />
  <main id="main-content" class="consulting-main">
    <Identity content={identity} />
    <SelectedWork content={selectedWorkSection} entries={selectedWork} />
    <Testimonial testimonial={featuredTestimonial} />
    <Writing content={writingSection} notes={latestFieldNotes(3)} />
    <NextStep content={nextStep} />
    <AdvisorFooter />
  </main>
</BaseLayout>

---
import ClosingCta from '../components/ClosingCta.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList, serviceNode } from '../lib/schema';
import { northernVirginia as c } from '../lib/content/northern-virginia';
import { chrome } from '../lib/content/navigation';
import { SITE_URL, SERVICE_AREA_PLACES } from '../site';
const pageUrl = `${SITE_URL}/northern-virginia-ai-workflow-automation/`;
---
<BaseLayout title={c.title} description={c.description} image="/og/northern-virginia.png" imageAlt={c.imageAlt} structuredData={[breadcrumbList([{name:chrome.breadcrumbHome,url:`${SITE_URL}/`},{name:c.breadcrumb,url:pageUrl}]),serviceNode({id:`${pageUrl}#service`,name:c.serviceName,description:c.description,url:pageUrl,areaServed:SERVICE_AREA_PLACES})]}>
  <PageIntro eyebrow={c.eyebrow} title={c.heading} deck={c.deck} />
  <article class="prose service-prose shell">{c.sections.map(section => <><h2>{section.heading}</h2><Fragment set:html={section.html} /></>)}</article><ClosingCta placement="nova-closing" />
</BaseLayout>

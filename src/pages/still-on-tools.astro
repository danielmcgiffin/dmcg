---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { research } from '../lib/content/research';
import { chrome } from '../lib/content/navigation';

const pageUrl = `${SITE_URL}/still-on-tools/`;
const structuredData = [
	breadcrumbList([
		{ name: chrome.breadcrumbHome, url: `${SITE_URL}/` },
		{ name: research.breadcrumb, url: pageUrl }
	])
];
import '../styles/pages/still-on-tools.css';
---

<BaseLayout title={research.title} description={research.description} structuredData={structuredData}>
	<SiteHeader />
	<main id="main-content">
		<header class="offer-hero section-dark">
			<div class="shell">
				<p class="eyebrow">{research.eyebrow}</p>
				<h1 class="display" set:html={research.headingHtml} />
				<p class="offer-deck">{research.deck}</p>
			</div>
		</header>

		<article class="prose service-prose shell" set:html={research.bodyHtml} />
	</main>
	<SiteFooter />
</BaseLayout>

---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { elsewhereLinks } from '../elsewhere-links';

import '../styles/pages/elsewhere.css';
---
<BaseLayout title="Elsewhere — Danny McGiffin" description="Email Danny McGiffin, find him on LinkedIn, Substack, and X, or arrange a conversation." pageType="WebPage" structuredData={breadcrumbList([{name:'Home',url:`${SITE_URL}/`},{name:'Elsewhere',url:`${SITE_URL}/elsewhere/`}])}>
  <SiteHeader />
  <main id="main-content" class="contact-hub">
    <div class="contact-hub-inner">
      <img class="contact-hub-portrait" src="/headshot.jpg" width="112" height="112" alt="" />
      <h1>Danny McGiffin</h1>
      <p class="contact-hub-location">Herndon, Virginia</p>
      <p class="contact-hub-intro">Independent advice before a consequential systems decision. Find me here, or start a conversation.</p>
      <nav class="contact-hub-links" aria-label="Ways to connect">
        {elsewhereLinks.map(({ label, detail, href, external }) => (
          <a href={href} rel={external ? 'noopener noreferrer' : undefined} target={external ? '_blank' : undefined}>
            <span><strong>{label}</strong><small>{detail}</small></span><span class="contact-hub-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <p class="contact-hub-note">Based in Herndon, Virginia.</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

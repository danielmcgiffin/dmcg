---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { elsewhere, elsewhereLinks } from '../lib/content/elsewhere';
import { chrome } from '../lib/content/navigation';

import '../styles/pages/elsewhere.css';
---
<BaseLayout title={elsewhere.title} description={elsewhere.description} pageType="WebPage" structuredData={breadcrumbList([{name:chrome.breadcrumbHome,url:`${SITE_URL}/`},{name:elsewhere.breadcrumb,url:`${SITE_URL}/elsewhere/`}])}>
  <SiteHeader />
  <main id="main-content" class="contact-hub">
    <div class="contact-hub-inner">
      <img class="contact-hub-portrait" src="/headshot.jpg" width="112" height="112" alt="" />
      <h1>{elsewhere.name}</h1>
      <p class="contact-hub-location">{elsewhere.location}</p>
      <p class="contact-hub-intro">{elsewhere.intro}</p>
      <nav class="contact-hub-links" aria-label={elsewhere.linksLabel}>
        {elsewhereLinks.map(({ label, detail, href, external }) => (
          <a href={href} rel={external ? 'noopener noreferrer' : undefined} target={external ? '_blank' : undefined}>
            <span><strong>{label}</strong><small>{detail}</small></span><span class="contact-hub-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <p class="contact-hub-note">{elsewhere.note}</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

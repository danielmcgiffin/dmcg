---
import OfferPage from '../../components/OfferPage.astro';
import { offerPages, offers, type Offer } from '../../lib/content/offers';
export function getStaticPaths() {
  return offers.map(offer => ({ params: { slug: offer.slug }, props: { offer } }));
}
const { offer } = Astro.props as { offer: Offer };
---
<OfferPage offer={offer} content={offerPages[offer.slug]} />

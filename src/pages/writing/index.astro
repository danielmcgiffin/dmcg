---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subscribeUrl } from '../../config';
import { fieldNotes as articles, formatNoteDate, writingIndex } from '../../lib/content/writing';
import '../../styles/pages/writing-index.css';
---
<BaseLayout title={writingIndex.title} description={writingIndex.description} pageType="CollectionPage">
  <header class="writing-intro shell">
    <div>
      <p class="eyebrow">Built that Way</p>
      <h1>Writing</h1>
      <p>Essays on business, technology, and how work actually gets done.</p>
      <a href={subscribeUrl('writing-index')} data-subscribe-link data-cta-placement="writing-index">Read and subscribe on Substack</a>
    </div>
    <img src="/built-that-way-square.jpg" width="800" height="800" alt={writingIndex.publicationAlt} />
  </header>
  <section class="writing-index shell" aria-label={writingIndex.listLabel}>
    {articles.map(article => <a href={article.href}>
      <h2>{article.title}</h2>
      <time datetime={article.publishedAt}>{formatNoteDate(article.publishedAt)}</time>
    </a>)}
  </section>
</BaseLayout>

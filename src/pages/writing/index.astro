---
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subscribeUrl } from '../../config';
import articles from '../../data/substack-posts.json';

import '../../styles/pages/writing-index.css';
---

<BaseLayout title="Writing — Danny McGiffin" description="Built that Way articles by Danny McGiffin on Substack." pageType="CollectionPage">
	<SiteHeader />
	<main id="main-content">
		<header class="writing-hero section-dark">
			<div class="shell">
				<h1 class="sr-only">Writing — Built that Way by Danny McGiffin</h1>
				<a class="writing-publication" href={subscribeUrl('writing-index')} data-subscribe-link data-cta-placement="writing-index">
					<img src="/built-that-way-square.jpg" width="800" height="800" alt="Built that Way by Danny McGiffin. Read and subscribe at dannymcgiffin.substack.com." fetchpriority="high" />
				</a>
			</div>
		</header>
		<section class="writing-index section-light shell" aria-label="Substack articles">
			{articles.map((article, index) => (
				<a href={article.href}>
					<span class="index">{String(index + 1).padStart(2, '0')}</span>
					<div><h2>{article.title}</h2></div>
					<time datetime={article.publishedAt}>{new Date(`${article.publishedAt}T00:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })}</time>
					<span class="round-arrow" aria-hidden="true"><ArrowUpRight /></span>
				</a>
			))}
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subscribeUrl } from '../../config';

const articles = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
import '../../styles/pages/writing-index.css';
---

<BaseLayout title="Writing — Danny McGiffin" description="Essays on how businesses work: ownership, decisions, systems, and technology." pageType="CollectionPage">
	<SiteHeader />
	<main id="main-content">
		<header class="writing-hero section-dark">
			<div class="shell">
				<h1 class="sr-only">Writing — Built that Way by Danny McGiffin</h1>
				<a class="writing-publication" href={subscribeUrl('writing-index')} data-subscribe-link data-cta-placement="writing-index">
					<img src="/built-that-way-square.jpg" width="800" height="800" alt="Built that Way by Danny McGiffin. Read and subscribe at dannymcgiffin.substack.com." fetchpriority="high" />
				</a>
			</div>
		</header>
		<section class="writing-briefing shell" aria-labelledby="briefing-title">
			<p class="eyebrow">Research briefing</p>
			<h2 id="briefing-title"><a href="/still-on-tools/">You're Not Late. You're Still on Tools. ↗</a></h2>
			<p>What four surveys can—and cannot—tell a smaller business about AI tools, workflow redesign, and the work between them.</p>
		</section>
		<section class="writing-index section-light shell" aria-label="All writing">
			{articles.map((article, index) => (
				<a href={`/writing/${article.id}/`}>
					<span class="index">{String(index + 1).padStart(2, '0')}</span>
					<div><h2>{article.data.title}</h2><p>{article.data.description}</p></div>
					<time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })}</time>
					<span class="round-arrow" aria-hidden="true"><ArrowUpRight /></span>
				</a>
			))}
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

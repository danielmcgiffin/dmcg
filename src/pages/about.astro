---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { elsewhereLinks } from '../elsewhere-links';
import { bookingUrl } from '../config';
---
<BaseLayout title="About Danny McGiffin — Business Advisor & Designer" description="I follow consequential business problems across departments, systems, incentives, and information to help leaders see what actually needs to change." bodyClass="about-timeline-page" pageType="AboutPage" structuredData={breadcrumbList([{name:'Home',url:`${SITE_URL}/`},{name:'About',url:`${SITE_URL}/about/`}])}>
  <header class="about-sidebar">
    <div><a class="about-name" href="/" aria-label="Danny McGiffin — Home">Danny McGiffin</a><p class="about-availability"><span aria-hidden="true"></span>Open for new clients</p></div>
    <nav class="about-desktop-nav" aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/#work">Selected work</a>
      <a href="/about/" aria-current="page">About me</a>
      <a href="/writing/">Writing</a>
      <a href="/contact/">Get in touch</a>
      <div class="nav-elsewhere"><a href="/elsewhere/">Elsewhere</a><ul class="elsewhere-sublinks">{elsewhereLinks.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
    </nav>
    <details class="about-mobile-menu">
      <summary>Menu <span aria-hidden="true">+</span></summary>
      <nav aria-label="Mobile navigation">
        <a href="/">Home</a><a href="/#work">Selected work</a><a href="/about/" aria-current="page">About me</a><a href="/writing/">Writing</a><a href="/contact/">Get in touch</a><div class="nav-elsewhere"><a href="/elsewhere/">Elsewhere</a><ul class="elsewhere-sublinks">{elsewhereLinks.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>
      </nav>
    </details>
  </header>
  <main id="main-content" class="about-main">
    <div class="about-column">
      <section class="about-intro" aria-labelledby="about-title">
        <h1 id="about-title">About me</h1>
        <p class="about-lead">I handle the problems that don’t fit neatly into a job description.</p>
        <p>Finance sees one piece. Operations sees another. IT sees another. The vendor has an answer. Leadership has to decide.</p>
        <p>My job is to figure out what problem the business actually has before you spend serious money solving the wrong one.</p>
        <p><a href={bookingUrl('about')}>Get a second opinion ↗</a></p>
      </section>
      <section class="about-opening" aria-labelledby="pattern-title">
        <h2 id="pattern-title">A recurring pattern</h2>
        <div class="reading-copy">
          <p>Finance sees reporting. Operations sees workarounds. IT sees systems. The vendor sees implementation. Leadership sees the cost.</p>
          <p>Usually, everybody is seeing something real.</p>
          <p>They’re just not seeing the whole thing.</p>
          <p>I follow the problem through the business: how the company makes money, who owns what, where information comes from, what the systems can actually represent, and what people have learned to work around.</p>
          <p>The interesting question is rarely “How do we fix this?”</p>
          <p>It’s “What is actually causing this?”</p>
          <p>Sometimes the answer is technology. Sometimes it’s process, incentives, authority, information, or organization.</p>
          <p>Sometimes the answer is: don’t buy the thing.</p>
        </div>
      </section>
      <section class="about-work" aria-labelledby="work-title">
        <h2 id="work-title">Selected work</h2>
        <section class="case-story" id="erp" aria-labelledby="erp-title">
          <p class="eyebrow">The investment decision</p>
          <div class="story-body">
            <h2 id="erp-title">The $2.5M ERP we decided not to implement.</h2>
            <p>A PE-backed distributor wanted a faster monthly close, cleaner data, and financial reporting good enough for its board and new owners.</p>
            <p>By the time I joined, it had already bought an enterprise ERP.</p>
            <p>The implementation problem looked ordinary at first: requirements, gaps, configuration, customization.</p>
            <p>It wasn’t.</p>
            <p>The software treated the company’s commercial relationships as relatively simple contracts between two parties. The actual business involved multiple parties, different rights and responsibilities, and commercial arrangements the ERP couldn’t represent cleanly.</p>
            <p>We could force it.</p>
            <p>We documented the gaps, and the integrator estimated more than $1 million in additional customization and remediation. Even then, the company would have been left with extensive workarounds and a heavily customized system.</p>
            <p>At that point the important question changed.</p>
            <p>It was no longer:</p>
            <p>How do we finish implementing this?</p>
            <p>It was:</p>
            <p>Should we be implementing it at all?</p>
            <p>I recommended that the CEO stop.</p>
            <p>Instead, I designed an alternative around QuickBooks, the existing operational systems, cleaned and normalized exports, a governed data layer, and analytics that could give management trustworthy information without forcing the business into a model that didn’t fit.</p>
            <p class="evidence-note">The alternative was estimated at roughly 2–5% of the ERP path’s cost and about one-fifth of the timeline.</p>
            <p class="story-principle">The implementation wasn’t the real problem. We were implementing the wrong model of the business.</p>
          </div>
        </section>
        <section class="case-story" id="collaboration" aria-labelledby="collaboration-title">
          <p class="eyebrow">The operating model</p>
          <div class="story-body">
            <h2 id="collaboration-title">Redesigning an operating model that made collaboration irrational.</h2>
            <p>A major professional-services firm wanted to grow in the federal market by bringing together expertise from its commercial practices.</p>
            <p>The strategy made sense.</p>
            <p>The operating model made cooperation a bad deal.</p>
            <p>Federal business development, contracts, administration, and program management sat together. Delivery depended on specialists in the commercial practices. But those leaders faced lower payment, rigid staffing rules, extra overhead, and arguments over who got credit for the revenue.</p>
            <p>Leadership could ask everyone to collaborate harder.</p>
            <p>That would not change the economics.</p>
            <p>So I redesigned the model.</p>
            <p>The commercial practice owned the client relationship. Federal became the enabling layer: opportunity identification, contracting expertise, administrative tools, guidance, and program support where needed.</p>
            <p>Then we clarified client ownership, delivery responsibility, decision rights, shared costs, and support.</p>
            <p>The behavior changed because the machinery underneath the behavior changed.</p>
            <p class="story-principle">If you want people to collaborate differently, change what makes their current behavior rational.</p>
          </div>
        </section>
        <section class="case-story" id="growth" aria-labelledby="growth-title">
          <p class="eyebrow">The growing business</p>
          <div class="story-body">
            <h2 id="growth-title">Building the company underneath 10× growth.</h2>
            <p>I was the first full-time person brought in to help build a professional-services firm.</p>
            <p>The founder had created the opportunity and remained the primary commercial relationship. My job was to help build the company underneath it.</p>
            <p>Within a month, we inherited most of the team supporting our principal client and grew to eight or nine people almost overnight.</p>
            <p>Across the firm, recognized revenue grew from roughly $200K to $2M in about a year. The team grew from one person to 15.</p>
            <p>Growth was not the hard part.</p>
            <p>Making the growth survivable was.</p>
            <p>My work included a PMO and consistent delivery cadence, management structure across client teams, hiring and onboarding, reporting and automation, and operating routines that reduced how much the founder had to carry personally.</p>
            <p>One of the systems I cared most about was extremely low-tech: a monthly one-on-one between the CEO and every employee.</p>
            <p>No status agenda. No project review. Just a protected conversation between two people.</p>
            <p>We retained 100% of the team during that period of rapid growth. When I left, those conversations were still happening as the company approached 20 people.</p>
            <p class="story-principle">A business needs to grow without destroying the things that made it worth growing in the first place.</p>
          </div>
        </section>
        <section class="case-story" id="navy" aria-labelledby="navy-title">
          <p class="eyebrow">The visibility problem</p>
          <div class="story-body">
            <h2 id="navy-title">Turning an unmeasurable $250M problem into a controllable system.</h2>
            <p>When I began working on the Navy’s improper-payments program, there was a more fundamental problem than reducing improper payments:</p>
            <p>We couldn’t reliably measure them.</p>
            <p>Before you can control a problem, you need to know where it happens, how often it happens, and why.</p>
            <p>Working with finance and payment experts, we built much of the program machinery from scratch: statistical estimation models, risk assessments, sampling and review methods, pre-payment controls, training, local review activity, and reporting for leadership.</p>
            <p>That gave us a way to find the points of leverage, put controls there, and see whether they were actually working.</p>
            <p>Over the course of the work, reported improper payments fell by roughly $250 million. Underlying error rates declined by roughly 45% over two years.</p>
            <p class="evidence-note">Those are program-level results, not a claim that I personally “saved the Navy $250 million.”</p>
            <p>The more interesting result was that an enormous, fuzzy problem became something people could see, investigate, and control.</p>
            <p class="story-principle">An enormous problem becomes much more tractable once you can measure it, find the causes, and put controls where they matter.</p>
          </div>
        </section>
      </section>
      <section class="about-background" aria-labelledby="background-title">
        <h2 id="background-title" class="eyebrow">What connects the work</h2>
        <p>My path has taken me from Army logistics into consulting, operations, enterprise systems, organizational design, and strategy.</p>
        <p>That sounds more eclectic than it feels.</p>
        <p>The recurring problem is usually the same: something important is happening between the boxes on the org chart, and no specialist owns the whole thing.</p>
        <p>So I follow the problem.</p>
        <p>Across departments. Across systems. Across incentives, responsibilities, information, and technology. Wherever it actually goes.</p>
        <p>I’m based in Herndon, Virginia, and work directly with owners and senior leaders who need to see a situation clearly, make a consequential decision, and design a better way for the business to work.</p>
      </section>
      <section class="about-contact" aria-labelledby="conversation-title">
        <h2 id="conversation-title">About to make an expensive decision?</h2>
        <p>You don’t need to have the problem neatly framed.</p>
        <p>In fact, that’s often the point.</p>
        <a href={bookingUrl('closing')}>Get a second opinion ↗</a>
      </section>
    </div>
    <footer class="about-footer"><span>© {new Date().getFullYear()} Danny McGiffin</span><a href="/elsewhere/">Elsewhere ↗</a></footer>
  </main>
</BaseLayout>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.about-mobile-menu');
  menu?.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
<style is:global>
  body.about-timeline-page { background: #fff; color: #303a32; font-family: "Geist", Arial, sans-serif; font-size: 17px; line-height: 1.55; }
  .about-timeline-page :focus-visible { outline: 2px solid #214d38; outline-offset: 4px; }
  .about-sidebar { position: fixed; inset: 0 auto 0 0; width: 223px; padding: 28px 24px; background: #ece7d9; border-right: 1px solid #e0e1d5; overflow-y: auto; }
  .about-name { display: inline-block; color: #214d38; font-size: 14px; font-weight: 700; text-transform: uppercase; }
  .about-availability { display: flex; align-items: baseline; gap: 7px; margin-top: 12px; color: #596154; font-size: 11px; }
  .about-availability span { flex: none; width: 6px; height: 6px; border-radius: 50%; background: #214d38; }
  .about-desktop-nav { margin-top: 40px; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .about-desktop-nav a { display: block; padding: 10px 0; font-size: 12px; text-transform: uppercase; }
  .about-desktop-nav > .nav-elsewhere > a { display: block; margin-top: 24px; color: #214d38; }
  .about-desktop-nav a[aria-current="page"] { color: #214d38; font-weight: 700; }
  .about-desktop-nav a:hover, .about-main a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .about-desktop-nav p { color: #214d38; font-size: 12px; margin: 30px 0 6px; }
  .about-mobile-menu { display: none; }
  .about-main { margin-left: 223px; min-height: 100vh; padding: 64px 54px 24px; background: #fff; }
  .about-column { max-width: 720px; margin-inline: auto; }
  .about-column p { margin: 0; }
  .about-column p + p { margin-top: 20px; }
  .about-intro { border-bottom: 1px solid #bfc9bd; padding-bottom: 32px; }
  .about-intro h1 { font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -.035em; margin: 0 0 20px; }
  .about-intro .about-lead { font-size: 1.3rem; line-height: 1.4; }
  .about-intro a, .about-contact a { color: #214d38; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .about-opening { display: block; padding: 36px 0 52px; }
  .about-opening h2, .about-work > h2, .about-background h2 { color: #214d38; font-size: 15px; font-weight: 700; letter-spacing: .08em; line-height: 1.4; margin: 0 0 18px; text-transform: uppercase; }
  .about-opening .reading-copy { max-width: none; }
  .about-opening .reading-copy p { color: #303a32; }
  .about-work { padding-top: 8px; }
  .about-work > h2 { margin-bottom: 28px; }
  .about-work .case-story { position: relative; display: block; border: 0; border-left: 2px solid #bfc9bd; padding: 0 0 48px 36px; margin-left: 13px; scroll-margin-top: 32px; }
  .about-work .case-story:last-child { padding-bottom: 0; }
  .about-work .case-story::before { content: ""; position: absolute; left: -14px; top: 0; width: 26px; height: 26px; border: 3px solid #fff; border-radius: 50%; background: #214d38; box-shadow: 0 0 0 1px #bfc9bd; }
  .about-work .case-story > .eyebrow { margin: 0 0 5px; color: #657267; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .about-work .case-story .story-body { max-width: none; }
  .about-work .case-story h2 { font-family: "Geist", Arial, sans-serif; font-size: clamp(1.3rem, 2.2vw, 1.65rem); font-weight: 600; line-height: 1.28; letter-spacing: -.02em; margin: 0 0 16px; }
  .about-work .case-story p { color: #303a32; margin-top: 16px; font-size: 16px; }
  .about-work .case-story .evidence-note { color: #596154; font-size: 14px; }
  .about-work .case-story .story-principle { color: #214d38; border-left: 2px solid #214d38; padding-left: 18px; margin-top: 24px; }
  .about-work .case-story ul { margin-top: 16px; color: #303a32; }
  .about-background { border-top: 1px solid #bfc9bd; margin-top: 52px; padding: 42px 0 36px; }
  .about-background p { max-width: none; margin: 0 0 18px; color: #303a32; }
  .about-contact { border-top: 1px solid #bfc9bd; padding: 40px 0 54px; }
  .about-contact h2 { font-size: 1.6rem; font-weight: 600; line-height: 1.3; margin: 0 0 12px; }
  .about-contact a { display: inline-block; margin-top: 18px; }
  .about-footer { max-width: 720px; margin: 0 auto; border-top: 1px solid #dce1d3; padding-top: 20px; display: flex; justify-content: space-between; gap: 20px; font-size: 12px; color: #596154; }
  @media (min-width: 1600px) { .about-main { margin-left: calc(223px + (100vw - 1600px) / 2); } }
  @media (max-width: 1024px) {
    .about-sidebar { position: relative; width: 100%; padding: 18px 28px; overflow: visible; display: flex; justify-content: space-between; align-items: center; border-right: 0; border-bottom: 1px solid #e0e1d5; z-index: 2; }
    .about-desktop-nav { display: none; }
    .about-mobile-menu { display: block; }
    .about-mobile-menu summary { display: flex; align-items: center; gap: 14px; min-height: 44px; font-size: 14px; list-style: none; cursor: pointer; }
    .about-mobile-menu summary::-webkit-details-marker { display: none; }
    .about-mobile-menu[open] summary span { transform: rotate(45deg); }
    .about-mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; background: #ece7d9; padding: 12px 28px 24px; border-bottom: 1px solid #bcc8b9; box-shadow: 0 8px 12px #283c2410; }
    .about-mobile-menu nav a { display: block; padding: 12px 0; font-size: 15px; }
    .about-main { margin-left: 0; padding: 48px 36px 24px; }
  }
  @media (max-width: 600px) {
    .about-sidebar { padding: 10px 22px; }
    .about-name { font-size: 13px; }
    .about-main { padding: 34px 24px 20px; }
    .about-intro .about-lead { font-size: 1.16rem; }
    .about-work .case-story { padding-left: 25px; margin-left: 10px; }
    .about-work .case-story::before { left: -12px; width: 22px; height: 22px; }
    .about-work .case-story h2 { font-size: 1.3rem; }
  }
</style>

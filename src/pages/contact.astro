---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookingUrl } from '../config';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL, CONTACT_EMAIL } from '../site';
import '../styles/pages/contact.css';
---
<BaseLayout title="Get in touch — Danny McGiffin" description="Get in touch with Danny McGiffin before a consequential systems decision." pageType="ContactPage" structuredData={breadcrumbList([{name:'Home',url:`${SITE_URL}/`},{name:'Contact',url:`${SITE_URL}/contact/`}])}>
  <SiteHeader />
  <main id="main-content" class="direct-contact">
    <div class="shell direct-contact-inner">
      <p class="eyebrow">Get in touch</p>
      <h1>Tell me what you’re deciding.</h1>
      <p>You don’t need a polished brief. The first 30-minute video call is free: we talk about your business and main pain points, then decide whether to dig deeper. <a href="/advisory/">See how an independent review works.</a></p>
      <div class="direct-contact-actions">
        <a class="direct-contact-button" href={bookingUrl('contact')}>Get a second opinion <span aria-hidden="true">↗</span></a>
        <a class="direct-contact-secondary" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("A decision worth talking through")}`}>Or send an email <span aria-hidden="true">↗</span></a>
      </div>
      <p class="direct-contact-email">Email directly: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p class="direct-contact-location">Based in Herndon, Virginia. The booked first call is by video; <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Meet locally in Northern Virginia')}`}>email me to arrange an in-person conversation</a>. Learn more about <a href="/northern-virginia-ai-workflow-automation/">working together in Northern Virginia</a>.</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookingUrl, CTA_LABEL } from '../config';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { contact } from '../lib/content/contact';
import { chrome } from '../lib/content/navigation';
import { offers } from '../lib/content/offers';
import '../styles/pages/contact.css';
---
<BaseLayout title={contact.title} description={contact.description} pageType="ContactPage" structuredData={breadcrumbList([{name:chrome.breadcrumbHome,url:`${SITE_URL}/`},{name:contact.breadcrumb,url:`${SITE_URL}/contact/`}])}>
  <SiteHeader />
  <main id="main-content" class="direct-contact">
    <div class="shell direct-contact-inner">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1>{contact.heading}</h1>
      <p>{contact.intro} <a href={`#${contact.offersAnchor}`}>{contact.offersLinkLabel}</a></p>
      <div class="direct-contact-actions">
        <a class="direct-contact-button" href={bookingUrl('contact')}>{CTA_LABEL} <span aria-hidden="true">↗</span></a>
        <a class="direct-contact-secondary" href={contact.emailButton.href}>{contact.emailButton.label} <span aria-hidden="true">↗</span></a>
      </div>
      <p class="direct-contact-email">{contact.emailLabel}<a href={contact.emailHref}>{contact.email}</a></p>
      <p class="direct-contact-location" set:html={contact.locationHtml} />
      <ul id={contact.offersAnchor}>
        {offers.map(item => <li><p><a href={item.href}>{item.name}</a>: {item.oneLiner}</p></li>)}
      </ul>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

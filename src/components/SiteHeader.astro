---
import { bookingUrl } from '../config';
import NavigationLinks from './NavigationLinks.astro';

interface Props {
  bookingLabel?: string;
  bookingPlacement?: string;
}

const { bookingLabel = 'Get a second opinion', bookingPlacement = 'navigation' } = Astro.props;
---
<header class="site-header">
  <div class="site-identity"><a class="wordmark" href="/" aria-label="Danny McGiffin — Home">Danny McGiffin</a><p class="site-availability"><span aria-hidden="true"></span>Open for new clients</p></div>
  <nav class="header-nav" aria-label="Primary navigation">
    <NavigationLinks />
    <a class="nav-booking" href={bookingUrl(bookingPlacement)}>{bookingLabel}</a>
  </nav>
  <details class="mobile-navigation">
    <summary>Menu <span aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile navigation">
      <NavigationLinks />
      <a class="nav-booking" href={bookingUrl(bookingPlacement)}>{bookingLabel}</a>
    </nav>
  </details>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>

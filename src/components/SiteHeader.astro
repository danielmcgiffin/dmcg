---
import ArrowUpRight from './ArrowUpRight.astro';
import { BOOKING_URL } from '../config';
---

<header class="site-header" data-site-header>
	<nav class="header-nav" aria-label="Primary navigation">
		<a href="/#work">What I do</a>
		<a href="/#offer">Teardown</a>
	</nav>
	<a class="wordmark" href="/">
		<span class="monogram" aria-hidden="true"><span>D</span></span>
		<span>Danny McGiffin</span>
	</a>
	<a class="button button--header" href={BOOKING_URL}>Book a call <ArrowUpRight /></a>
</header>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		const header = document.querySelector('[data-site-header]');
		if (!header) return;
		const hero = document.querySelector('.hero, .offer-hero, .writing-hero, .article-hero');
		if (!hero) {
			header.classList.add('is-solid');
			return;
		}
		const sync = () => {
			const line = header.getBoundingClientRect().bottom;
			header.classList.toggle('is-solid', hero.getBoundingClientRect().bottom <= line);
		};
		sync();
		window.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
	});
</script>

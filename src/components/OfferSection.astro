---
import ArrowUpRight from './ArrowUpRight.astro';
import { BOOKING_URL } from '../config';

const outcomes = [
	'Which work is consuming the most capacity',
	'What that work costs you now',
	'What the redesigned workflow should look like',
	'What a fixed-price build would cost, if there is something worth building'
] as const;
---

<section class="offer section-light" id="offer" aria-labelledby="offer-title">
	<div class="shell">
		<p class="eyebrow reveal">The Workflow Teardown</p>
		<div class="teardown reveal">
			<div>
				<h2 id="offer-title" class="display">Find out what your manual work is actually costing you.</h2>
				<p class="teardown-price">$5,000</p>
				<p class="teardown-meta">Two weeks. Credited toward the build.</p>
				<p class="teardown-refund">
					If you read the report and do not think it was worth $5,000, tell me within two weeks of delivery. I
					refund it in full. You keep the report. You decide.
				</p>
			</div>
			<div class="page-copy">
				<p>
					I will dig into the parts of your operation where manual work, delays, or headcount appear to be
					limiting growth. You do not need to know what should be automated.
				</p>
				<p>At the end, you will know:</p>
				<ul>
					{outcomes.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<p class="teardown-candor">If there is nothing worth automating, I will tell you.</p>
				<p>No giant transformation program. No AI strategy deck. No technology looking for a problem.</p>
				<a class="button button--primary" href={BOOKING_URL}>Show me the work <ArrowUpRight /></a>
				<p class="hero-note">Bring one ugly, manual, expensive process.</p>
			</div>
		</div>
	</div>
</section>

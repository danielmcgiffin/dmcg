---
import ArrowUpRight from './ArrowUpRight.astro';
import { bookingUrl } from '../config';

const outcomes = [
	'Which work is consuming the most capacity',
	'What that work costs you now',
	'What the redesigned workflow should look like',
	'What a fixed-price build would cost, if there is something worth building'
] as const;
---

<section class="offer section-light" id="offer" aria-labelledby="offer-title">
	<div class="shell">
		<p class="eyebrow reveal">The Workflow Teardown</p>
		<h2 id="offer-title" class="display reveal">Find out what your manual work is actually costing you.</h2>
		<div class="teardown reveal">
			<div class="page-copy">
				<p>
					I will dig into the parts of your operation where manual work, delays, or systems issues are hindering growth. Then we'll identify what should be redesigned and what should be automated.
				</p>
				<p>By the end, you will know:</p>
				<ul>
					{outcomes.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<p class="teardown-candor">If there is nothing worth automating, then I'll say that.</p>
				<p>No giant transformation program. No AI strategy deck. No technology in search of a problem.</p>
			</div>
			<div class="teardown-panel">
				<p class="teardown-price">$5,000</p>
				<p class="teardown-meta">Two weeks. Credited toward any subsequent build.</p>
				<p class="teardown-refund">
					If we don't find anything to streamline, or you feel your report wasn't worth $5,000, tell me within two weeks of delivery and I'll	refund it in full. You can still keep the report.
				</p>
				<a class="button button--primary" href={bookingUrl('offer')}>Show me the work <ArrowUpRight /></a>
			</div>
		</div>
	</div>
</section>

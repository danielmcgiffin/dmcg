---
/**
 * Geist has no glyph for U+2197, so a literal ↗ falls back to a system font
 * and changes shape on every platform. This draws it instead.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class:list={['arrow-ne', className]}
	viewBox="0 0 12 12"
	width="1em"
	height="1em"
	fill="none"
	stroke="currentColor"
	stroke-width="1.1"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
><path d="M3.1 8.9 8.9 3.1" /><path d="M4.4 3.1H8.9V7.6" /></svg>

---
import { chrome } from '../lib/content/navigation';

interface Props {
  about?: boolean;
}

const { about = false } = Astro.props;
---
<footer class:list={['advisor-footer', { 'advisor-footer--about': about }]}>
  <span>{chrome.copyright(new Date().getFullYear())}</span>
  <a href={chrome.footerLink.href}>{chrome.footerLink.label}</a>
</footer>

---
/** AI Opportunity has its own layout: the pitch tension, illustrative opportunity map, and evaluation dimensions. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { bookingUrl, CTA_LABEL } from '../config';
import { breadcrumbList } from '../lib/schema';
import { SITE_URL } from '../site';
import { aiOpportunityPage as c, offerPageLabels as l, type Offer } from '../lib/content/offers';
import '../styles/pages/ai.css';

interface Props { offer: Offer; }
const { offer } = Astro.props;
const pageUrl = `${SITE_URL}${offer.href}`;
---
<BaseLayout
  title={c.title}
  description={c.description}
  image={`/og/${offer.slug}.png`}
  imageAlt={c.imageAlt}
  bodyClass="ai-page"
  structuredData={breadcrumbList([{ name: l.breadcrumbHome, url: `${SITE_URL}/` }, { name: offer.name, url: pageUrl }])}
>
  <SiteHeader bookingPlacement="ai-navigation" />
  <main id="main-content">
    <div class="ai-wrap">
      <header class="ai-hero">
        <p class="ai-eyebrow">{offer.name}</p>
        <h1 set:html={c.hero.headlineHtml} />
        <p class="ai-deck">{c.hero.deck}</p>
        <p class="ai-offer-facts"><strong>{offer.price}</strong><span>{offer.duration}</span><span>{l.heroGuarantee}</span></p>
        <div class="ai-actions">
          <a class="ai-button" href={bookingUrl('ai-hero')}>{CTA_LABEL} <span aria-hidden="true">↗</span></a>
          <a class="ai-text-link" href="#opportunity-map">{l.seeWhatYouGet} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="ai-small">{l.heroSmall}</p>
        <ul class="ai-independence" aria-label={l.independenceLabel}>
          {c.hero.independence.map(item => <li>{item}</li>)}
        </ul>
      </header>

      <section class="ai-section ai-tension" aria-labelledby="tension-title">
        <p class="ai-eyebrow">{c.tension.eyebrow}</p>
        <h2 id="tension-title" set:html={c.tension.titleHtml} />
        <div class="ai-voices">
          {c.tension.voices.map(([speaker, quote]) => <p><span>{speaker}</span>{quote}</p>)}
        </div>
        <p class="ai-conclusion">{c.tension.conclusion}</p>
      </section>


      <section class="ai-section" aria-labelledby="look-title">
        <p class="ai-eyebrow">{c.look.eyebrow}</p>
        <h2 id="look-title">{c.look.title}</h2>
        <div class="ai-opportunities">
          {c.look.opportunities.map(([label, title, detail]) => <article><p class="ai-eyebrow">{label}</p><h3>{title}</h3><p>{detail}</p></article>)}
        </div>
        <p class="ai-section-note">{c.look.note}</p>
      </section>

      <section class="ai-section ai-deliverable" id="opportunity-map" aria-labelledby="map-title">
        <p class="ai-eyebrow">{c.map.eyebrow}</p>
        <h2 id="map-title" set:html={c.map.titleHtml} />
        <p class="ai-section-intro">{c.map.intro}</p>
        <div class="ai-map">
          <div class="ai-map-heading"><span>{c.map.heading}</span><span class="ai-example-label">{c.map.exampleLabel}</span></div>
          <p class="ai-map-disclosure">{c.map.disclosure}</p>
          <div class="ai-buckets" aria-label={c.map.bucketsLabel}>
            {c.map.buckets.map(bucket => <div><span class={`ai-dot ai-dot--${bucket.tone}`}></span><strong>{bucket.title}</strong><small>{bucket.detail}</small></div>)}
          </div>
          {c.map.samples.map(sample => (
            <details class="ai-opportunity" name="sample-opportunity" open={sample.open}>
              <summary><span><small>{sample.label}</small><strong>{sample.title}</strong></span><span class={`ai-status ai-status--${sample.tone}`}>{sample.status}</span><span class="ai-toggle" aria-hidden="true">+</span></summary>
              <div class="ai-opportunity-body">
                <p class={sample.introLead ? 'ai-opportunity-intro' : undefined}>{sample.intro}</p>
                {sample.economics && <dl class="ai-economics">{sample.economics.map(([term, value, note]) => <div><dt>{term}</dt><dd>{value}</dd><small>{note}</small></div>)}</dl>}
                <dl class="ai-record">{sample.record.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
                {sample.note && <p class="ai-assumption-note">{sample.note}</p>}
              </div>
            </details>
          ))}
        </div>
        <div class="ai-delivery-list">
          {c.map.deliverables.map(([title, detail]) => <p><strong>{title}</strong><span>{detail}</span></p>)}
        </div>
        <a class="ai-text-link" href={bookingUrl('ai-deliverable')}>{CTA_LABEL} ↗</a>
      </section>

      <section class="ai-section" aria-labelledby="pressure-title">
        <p class="ai-eyebrow">{c.pressure.eyebrow}</p>
        <h2 id="pressure-title">{c.pressure.title}</h2>
        <div class="ai-dimensions">{c.pressure.dimensions.map(([title, detail], i) => <article><span class="ai-number">0{i + 1}</span><div><h3>{title}</h3><p>{detail}</p></div></article>)}</div>
      </section>

      <section class="ai-section ai-proof" aria-labelledby="proof-title">
        <p class="ai-eyebrow">{c.proof.eyebrow}</p>
        <h2 id="proof-title">{c.proof.title}</h2>
        <p class="ai-proof-lead">{c.proof.lead}</p>
        <div class="ai-proof-numbers"><p><strong>{l.proofMetrics[0].value}</strong><span>{l.proofMetrics[0].label}</span></p><span class="ai-proof-arrow" aria-hidden="true">→</span><p><strong>{l.proofMetrics[1].value}</strong><span>{l.proofMetrics[1].label}</span></p></div>
        <p>{c.proof.body}</p>
        <p class="ai-small">{c.proof.small}</p>
        <a class="ai-text-link" href={l.proofHref}>{l.proofLinkLabel}</a>
      </section>

      <section class="ai-section" aria-labelledby="process-title">
        <p class="ai-eyebrow">{l.processEyebrow}</p>
        <h2 id="process-title" set:html={c.process.titleHtml} />
        <ol class="ai-process">{c.process.steps.map(([number, title, detail]) => <li><span class="ai-number">{number}</span><div><h3>{title}</h3><p>{detail}</p></div></li>)}</ol>
        <p class="ai-section-note">{c.process.note}</p>
      </section>

      <section class="ai-section ai-bio" aria-labelledby="bio-title">
        <img src="/headshot.jpg" width="400" height="400" alt={c.bio.imageAlt} loading="lazy" />
        <div><p class="ai-eyebrow">{c.bio.eyebrow}</p><h2 id="bio-title">{c.bio.title}</h2>{c.bio.paragraphs.map(text => <p>{text}</p>)}<p class="ai-small">{c.bio.small}</p><a class="ai-text-link" href="/about/">{c.bio.linkLabel}</a></div>
      </section>

      <section class="ai-section" id="fit" aria-labelledby="fit-title">
        <p class="ai-eyebrow">{l.fitEyebrow}</p>
        <h2 id="fit-title">{c.fit.title}</h2>
        <div class="ai-fit-grid"><div><h3>{l.fitLabel}</h3><ul>{c.fit.fit.map(item => <li>{item}</li>)}</ul></div><div><h3>{l.notFitLabel}</h3><ul>{c.fit.notFit.map(item => <li>{item}</li>)}</ul></div></div>
      </section>

      <section class="ai-offer" aria-labelledby="offer-title">
        <div><p class="ai-eyebrow">{c.offerBlock.eyebrow}</p><h2 id="offer-title" set:html={c.offerBlock.titleHtml} /><p>{c.offerBlock.text}</p><p class="ai-small">{c.offerBlock.small}</p></div>
        <div class="ai-offer-action"><a class="ai-button" href={bookingUrl('ai-offer')}>{CTA_LABEL} ↗</a><p class="ai-small">{l.offerSmall[0]}<br />{l.offerSmall[1]}</p></div>
        <div class="ai-offer-boundary"><strong>{l.boundaryTitle}</strong><p>{c.offerBlock.boundaryText}</p></div>
      </section>

      <section class="ai-guarantee" aria-labelledby="guarantee-title">
        <p class="ai-eyebrow">{l.guaranteeEyebrow}</p>
        <h2 id="guarantee-title">{l.guaranteeTitle}</h2>
        <p>{c.guarantee.text}</p>
        <p class="ai-small">{c.guarantee.small}</p>
      </section>

      <section class="ai-section ai-faq" aria-labelledby="faq-title"><p class="ai-eyebrow">{l.faqEyebrow}</p><h2 id="faq-title">{l.faqTitle}</h2>{c.faqs.map(([question, answer]) => <details><summary>{question}<span class="ai-toggle" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</section>

      <section class="ai-close" aria-labelledby="close-title"><p class="ai-eyebrow">{l.closeEyebrow}</p><h2 id="close-title">{c.close.title}</h2><p>{c.close.text}</p><a class="ai-button" href={bookingUrl('ai-closing')}>{CTA_LABEL} ↗</a><p class="ai-small">{l.closeSmall}</p></section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

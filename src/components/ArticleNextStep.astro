---
import { subscribeUrl } from '../config';
import { articleLabels, articleNextSteps } from '../lib/content/writing';

interface Props { id: string; }
const { id } = Astro.props;
const step = articleNextSteps[id];
import '../styles/components/article-next-step.css';
---
{step && <aside class="article-next-step shell" aria-label={articleLabels.nextStepLabel}>
  <h2>{step.title}</h2>
  <p>{step.description}</p>
  <div class="article-next-actions">
    <a href={step.primary.href}>{step.primary.label} ↗</a>
    <a href={step.secondary.href}>{step.secondary.label} ↗</a>
  </div>
  <p class="article-subscribe">{articleLabels.subscribeBefore}<a href={subscribeUrl(`article-${id}`)} data-subscribe-link data-cta-placement={`article-${id}`}>{articleLabels.subscribeLink}</a>{articleLabels.subscribeAfter}</p>
</aside>}

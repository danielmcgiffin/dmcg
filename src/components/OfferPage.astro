---
/**
 * Offer page skeleton shared by the fixed-scope services:
 * hero, price/time/guarantee, symptoms, what you get, process, fit, FAQ, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { bookingUrl, CTA_LABEL } from '../config';
import { breadcrumbList, serviceNode } from '../lib/schema';
import { SITE_URL } from '../site';
import { offerPageLabels as l, type Offer, type OfferPageContent } from '../lib/content/offers';
import '../styles/pages/ai.css';

interface Props {
  offer: Offer;
  content: OfferPageContent;
}

const { offer, content: p } = Astro.props;
const pageUrl = `${SITE_URL}${offer.href}`;
const placement = (spot: string) => bookingUrl(`${offer.slug}-${spot}`);
---
<BaseLayout
  title={p.title}
  description={p.description}
  image={`/og/${offer.slug}.png`}
  imageAlt={p.imageAlt}
  bodyClass="ai-page"
  structuredData={[
    breadcrumbList([{ name: l.breadcrumbHome, url: `${SITE_URL}/` }, { name: offer.name, url: pageUrl }]),
    serviceNode({ id: `${pageUrl}#service`, name: offer.name, description: p.description, url: pageUrl }),
  ]}
>
  <SiteHeader bookingPlacement={`${offer.slug}-navigation`} />
  <main id="main-content">
    <div class="ai-wrap">
      <header class="ai-hero">
        <p class="ai-eyebrow">{offer.name}</p>
        <h1>{p.headline} <em>{p.emphasis}</em></h1>
        <p class="ai-deck">{p.deck}</p>
        <p class="ai-offer-facts"><strong>{offer.price}</strong><span>{offer.duration}</span>{p.guarantee && <span>{l.heroGuarantee}</span>}</p>
        <div class="ai-actions">
          <a class="ai-button" href={placement('hero')}>{CTA_LABEL} <span aria-hidden="true">↗</span></a>
          <a class="ai-text-link" href="#what-you-get">{l.seeWhatYouGet} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="ai-small">{l.heroSmall}</p>
        <ul class="ai-independence" aria-label={l.independenceLabel}>
          {l.independence.map(item => <li>{item}</li>)}
        </ul>
      </header>

      <section class="ai-section" aria-labelledby="symptoms-title">
        <p class="ai-eyebrow">{l.symptomsEyebrow}</p>
        <h2 id="symptoms-title">{p.symptomsTitle}</h2>
        <div class="ai-opportunities">
          {p.symptoms.map(([label, title, detail]) => <article><p class="ai-eyebrow">{label}</p><h3>{title}</h3><p>{detail}</p></article>)}
        </div>
        {p.symptomsNote && <p class="ai-section-note">{p.symptomsNote}</p>}
      </section>

      <section class="ai-section" id="what-you-get" aria-labelledby="output-title">
        <p class="ai-eyebrow">{l.outputEyebrow}</p>
        <h2 id="output-title">{p.outputTitle}</h2>
        <p class="ai-section-intro">{p.outputIntro}</p>
        <div class="ai-delivery-list">
          {p.deliverables.map(([title, detail]) => <p><strong>{title}</strong><span>{detail}</span></p>)}
        </div>
      </section>

      <section class="ai-section" aria-labelledby="process-title">
        <p class="ai-eyebrow">{l.processEyebrow}</p>
        <h2 id="process-title">{offer.duration}.<br />{l.processSubtitle}</h2>
        <ol class="ai-process">{p.steps.map(([title, detail], i) => <li><span class="ai-number">0{i + 1}</span><div><h3>{title}</h3><p>{detail}</p></div></li>)}</ol>
        <p class="ai-section-note">{p.processNote}</p>
      </section>

      {p.proof && (
        <section class="ai-section ai-proof" aria-labelledby="proof-title">
          <p class="ai-eyebrow">{l.proofEyebrow}</p>
          <h2 id="proof-title">{p.proof.title}</h2>
          <p class="ai-proof-lead">{p.proof.lead}</p>
          <div class="ai-proof-numbers"><p><strong>{l.proofMetrics[0].value}</strong><span>{l.proofMetrics[0].label}</span></p><span class="ai-proof-arrow" aria-hidden="true">→</span><p><strong>{l.proofMetrics[1].value}</strong><span>{l.proofMetrics[1].label}</span></p></div>
          <p>{p.proof.body}</p>
          {p.proof.small && <p class="ai-small">{p.proof.small}</p>}
          <a class="ai-text-link" href={l.proofHref}>{l.proofLinkLabel}</a>
        </section>
      )}

      <section class="ai-section" id="fit" aria-labelledby="fit-title">
        <p class="ai-eyebrow">{l.fitEyebrow}</p>
        <h2 id="fit-title">{l.fitTitle}</h2>
        <div class="ai-fit-grid"><div><h3>{l.fitLabel}</h3><ul>{p.fit.map(item => <li>{item}</li>)}</ul></div><div><h3>{l.notFitLabel}</h3><ul>{p.notFit.map(item => <li>{item}</li>)}</ul></div></div>
      </section>

      <section class="ai-offer" aria-labelledby="offer-title">
        <div><p class="ai-eyebrow">{offer.name}</p><h2 id="offer-title">{offer.price}.<br />{offer.duration}.</h2><p>{offer.oneLiner}</p></div>
        <div class="ai-offer-action"><a class="ai-button" href={placement('offer')}>{CTA_LABEL} ↗</a><p class="ai-small">{l.offerSmall[0]}<br />{l.offerSmall[1]}</p></div>
        <div class="ai-offer-boundary"><strong>{l.boundaryTitle}</strong><p>{l.boundaryText}</p></div>
      </section>

      {p.guarantee && (
        <section class="ai-guarantee" aria-labelledby="guarantee-title">
          <p class="ai-eyebrow">{l.guaranteeEyebrow}</p>
          <h2 id="guarantee-title">{l.guaranteeTitle}</h2>
          <p>{p.guarantee}</p>
        </section>
      )}

      <section class="ai-section ai-faq" aria-labelledby="faq-title"><p class="ai-eyebrow">{l.faqEyebrow}</p><h2 id="faq-title">{l.faqTitle}</h2>{p.faqs.map(([question, answer]) => <details><summary>{question}<span class="ai-toggle" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</section>

      <section class="ai-close" aria-labelledby="close-title"><p class="ai-eyebrow">{l.closeEyebrow}</p><h2 id="close-title">{p.closeTitle}</h2><p>{p.closeText}</p><a class="ai-button" href={placement('closing')}>{CTA_LABEL} ↗</a><p class="ai-small">{l.closeSmall}</p></section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

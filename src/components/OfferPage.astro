---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookingUrl, CTA_LABEL } from '../config';
import { breadcrumbList, serviceNode } from '../lib/schema';
import { SITE_URL } from '../site';
import { type Offer, type OfferPageContent } from '../lib/content/offers';
import { aiExample } from '../lib/content/ai-example';
import '../styles/pages/offers.css';
interface Props { offer: Offer; content: OfferPageContent; }
const { offer, content: page } = Astro.props;
const pageUrl = `${SITE_URL}${offer.href}`;
---
<BaseLayout title={page.title} description={page.description} image={`/og/${offer.slug}.png`} imageAlt={page.imageAlt}
  structuredData={[
    breadcrumbList([{ name: 'Home', url: `${SITE_URL}/` }, { name: offer.name, url: pageUrl }]),
    serviceNode({ id: `${pageUrl}#service`, name: offer.name, description: page.description, url: pageUrl }),
  ]}>
  <div class="offer-page shell">
    <header class="offer-overview">
      <p class="eyebrow">{offer.name}</p>
      <h1>{page.headline}</h1>
      <p class="offer-deck">{page.deck}</p>
      <p class="offer-terms"><strong>{offer.price}</strong><span>{offer.duration}</span></p>
      <a class="button" href={bookingUrl(`${offer.slug}-hero`)}>{CTA_LABEL}</a>
      <p class="offer-intro-note">Free 30-minute conversation. Scope agreed before paid work begins.</p>
      <h2>What you get</h2>
      <dl class="deliverables">{page.deliverables.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}</dl>
    </header>
    <section class="offer-details" aria-labelledby="details-title">
      <h2 id="details-title">The details</h2>
      <details>
        <summary>How the engagement works</summary>
        <ol class="offer-process">{page.steps.map(([title, detail]) => <li><strong>{title}.</strong> {detail}</li>)}</ol>
        <p>{page.processNote}</p>
        <p>No software purchase, implementation contract, or continuing engagement is required.</p>
      </details>
      <details id="fit">
        <summary>When this is a good fit</summary>
        <ul>{page.fit.map(item => <li>{item}</li>)}</ul>
        <h3>When something else would help more</h3>
        <ul>{page.notFit.map(item => <li>{item}</li>)}</ul>
      </details>
      {offer.slug === 'ai-opportunity' && <details id="opportunity-map" class="example-map">
        <summary>See an example opportunity map</summary>
        <p>{aiExample.disclosure}</p>
        {aiExample.samples.map(sample => <details name="sample-opportunity" open={'open' in sample && sample.open}>
          <summary>{sample.title}<span class="example-status">{sample.status}</span></summary>
          <p>{sample.intro}</p>
          {'economics' in sample && <dl class="example-economics">{sample.economics.map(([term, value, note]) => <div><dt>{term}</dt><dd><strong>{value}</strong><span>{note}</span></dd></div>)}</dl>}
          <dl class="example-record">{sample.record.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
          {'note' in sample && <p>{sample.note}</p>}
        </details>)}
      </details>}
      {page.proof && <details>
        <summary>Related work: the ERP decision</summary>
        <p>{page.proof.lead}</p><p>{page.proof.body}</p>
        {page.proof.small && <p>{page.proof.small}</p>}
        <p><a href="/work/erp-decision/">Read the ERP case</a></p>
      </details>}
      {page.guarantee && <details>
        <summary>Worth the fee, or your money back</summary>
        <p>{page.guarantee}</p>
      </details>}
      {page.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </section>
  </div>
</BaseLayout>

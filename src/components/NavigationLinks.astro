---
import { primaryLinks } from '../lib/content/navigation';
const path = Astro.url.pathname;
---
<ul class="navigation-links">
  {primaryLinks.map(({ href, label }) => (
    <li><a href={href} aria-current={path === href ? 'page' : undefined}
      class:list={{ 'section-current': path !== href && path.startsWith(href) }}>{label}</a></li>
  ))}
</ul>

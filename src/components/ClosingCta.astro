---
import { bookingUrl, CTA_LABEL } from '../config';
import { closingCta } from '../lib/content/navigation';
interface Props { placement?: string; }
const { placement = 'closing' } = Astro.props;
---
<section class="conversation shell" aria-labelledby="conversation-title">
  <h2 id="conversation-title">{closingCta.title}</h2>
  {closingCta.paragraphs.map(text => <p>{text}</p>)}
  <a class="button" href={bookingUrl(placement)}>{CTA_LABEL}</a>
</section>

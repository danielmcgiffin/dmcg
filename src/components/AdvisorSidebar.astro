---
import { bookingUrl } from '../config';
import NavigationLinks from './NavigationLinks.astro';

interface Props {
  current: '/' | '/about/';
}

const { current } = Astro.props;
---
<header class:list={['advisor-sidebar', { 'advisor-sidebar--home': current === '/' }]}>
  <div class="advisor-identity">
    <a class="advisor-name" href="/" aria-label="Danny McGiffin — Home">Danny McGiffin</a>
    <p class="advisor-availability"><span aria-hidden="true"></span>Open for new clients</p>
  </div>
  <nav class="advisor-desktop-nav" aria-label="Primary navigation">
    <NavigationLinks />
    <a class="nav-booking" href={bookingUrl('navigation')}>Get a second opinion</a>
  </nav>
  <details class="advisor-mobile-menu">
    <summary>Menu <span aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile navigation">
      <NavigationLinks />
      <a class="nav-booking" href={bookingUrl('navigation')}>Get a second opinion</a>
    </nav>
  </details>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.advisor-mobile-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

---
import type { WritingSectionContent } from '../../content/home';
import { formatNoteDate, type FieldNote } from '../../content/writing';

interface Props { content: WritingSectionContent; notes: readonly FieldNote[]; }
const { content, notes } = Astro.props;
---
<section class="consulting-section consulting-about" aria-labelledby="writing-title">
  <h2 class="consulting-label" id="writing-title">{content.heading}</h2>
  <p>{content.intro}</p>
  <div class="consulting-cases">
    <ul>{notes.map(note => <li><a href={note.href}>{note.title}</a><span><time datetime={note.publishedAt}>{formatNoteDate(note.publishedAt)}</time></span></li>)}</ul>
    <a class="consulting-inline-link" href="/writing/">{content.allLabel}</a>
  </div>
</section>

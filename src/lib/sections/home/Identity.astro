---
import type { IdentityContent } from '../../content/home';

interface Props { content: IdentityContent; }
const { content } = Astro.props;
---
<section class="consulting-intro" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title">{content.name}</h1>
    <p class="consulting-deck">{content.title}</p>
    <p class="consulting-neutral">{content.description}</p>
  </div>
  <img class="consulting-portrait" src="/headshot.jpg" width="400" height="400" alt={content.portraitAlt} fetchpriority="high" />
</section>

---
import type { NextStepContent } from '../../content/home';

interface Props { content: NextStepContent; }
const { content } = Astro.props;
---
<section class="consulting-close" aria-labelledby="conversation-title">
  <p class="consulting-label">{content.eyebrow}</p>
  <h2 id="conversation-title">{content.heading}</h2>
  <p>{content.body}</p>
  <a class="consulting-button" href={content.primaryHref}>{content.primaryLabel}</a>
  <p class="consulting-note"><a href={content.secondaryHref}>{content.secondaryLabel}</a></p>
</section>

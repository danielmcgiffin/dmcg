---
import type { CollectionEntry } from 'astro:content';
import { reviewNode } from '../lib/schema';

interface Props {
	entries: CollectionEntry<'proof'>[];
	headline: string;
}

const { entries, headline } = Astro.props;
const reviews = entries
	.filter((entry) => entry.data.name)
	.map((entry) =>
		reviewNode({
			reviewBody: `${entry.data.metric_line} ${entry.data.context}`.trim(),
			authorName: entry.data.name!,
			authorJobTitle: entry.data.jobTitle,
			organization: entry.data.organization
		})
	);
---

{
	reviews.length > 0 && (
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': reviews })}
		/>
	)
}

<section class="proof section-dark" aria-labelledby="proof-title">
	<div class="section-grid section-heading">
		<p class="eyebrow reveal">Evidence/</p>
		<h2 id="proof-title" class="display reveal">{headline}</h2>
	</div>
	<div class="proof-grid shell reveal">
		{entries.map(({ data }) => (
			<article>
				<p class="proof-metric">{data.metric_line}</p>
				<p class="proof-context">{data.context}</p>
				<p class="proof-attribution">
					{data.name ? [data.name, data.jobTitle, data.organization].filter(Boolean).join(' · ') : data.attribution}
				</p>
			</article>
		))}
	</div>
</section>

---
import { getCollection } from 'astro:content';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Writing — Danny McGiffin" description="Notes on work, systems, automation, and leverage." pageType="CollectionPage">
	<SiteHeader />
	<main id="main-content">
		<header class="writing-hero section-dark">
			<div class="shell">
				<p class="eyebrow">Writing/</p>
				<h1 class="display">Notes on work,<br />systems, and <em>leverage.</em></h1>
			</div>
		</header>
		<section class="writing-index section-light shell" aria-label="All writing">
			{articles.map((article, index) => (
				<a href={`/writing/${article.id}/`}>
					<span class="index">{String(index + 1).padStart(2, '0')}</span>
					<div><h2>{article.data.title}</h2><p>{article.data.description}</p></div>
					<time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
					<span class="round-arrow" aria-hidden="true"><ArrowUpRight /></span>
				</a>
			))}
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

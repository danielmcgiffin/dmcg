N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/systemscraft-owner-leads
N8N_WEBHOOK_TOKEN=replace-with-a-long-random-secret
DRY_RUN=true
HTTP_TIMEOUT=30

# Optional cheap-search credential. The default structured-index run does not need it.
# BRAVE_SEARCH_API_KEY=

# Optional pre-existing free/basic reader endpoint. Use {url} as the URL placeholder.
# BASIC_READER_URL=

# Firecrawl may remain in the Hermes environment instead of this project file.
# FIRECRAWL_API_KEY=
